table Workforce

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'إجمالي الموظفين' = COUNTROWS(Workforce)
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'على رأس العمل' = CALCULATE([إجمالي الموظفين], Workforce[الحالة_الوظيفية] = "على رأس العمل")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'نسبة السعودة' = DIVIDE(CALCULATE([إجمالي الموظفين], Workforce[الجنسية] = "سعودي"), [إجمالي الموظفين])
		formatString: 0.0%

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'متوسط الأداء الصحيح' = AVERAGE(Workforce[تقييم_الأداء_2025])
		formatString: 0.0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'رواتب على رأس العمل (ر.س)' = CALCULATE(SUM(Workforce[الراتب_الأساسي]), Workforce[الحالة_الوظيفية] = "على رأس العمل")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'تصنيف منتهي - على رأس العمل' = CALCULATE([إجمالي الموظفين], Workforce[الحالة_الوظيفية] = "على رأس العمل", Workforce[حالة_التصنيف] = "منتهي")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'تصنيفات منتهية - جميع الحالات' = CALCULATE([إجمالي الموظفين], Workforce[حالة_التصنيف] = "منتهي")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'ينتهي خلال 90 يوم' = CALCULATE([إجمالي الموظفين], Workforce[حالة_التصنيف] = "ينتهي خلال 90 يوم")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'حالة وظيفية مفقودة' = CALCULATE([إجمالي الموظفين], Workforce[الحالة_الوظيفية] = "غير محدد")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'تعارض وظيفي محتمل' = CALCULATE([إجمالي الموظفين], Workforce[تعارض_الدور] = "يحتاج مراجعة")
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'رواتب صفرية' = CALCULATE([إجمالي الموظفين], Workforce[الراتب_الأساسي] = 0)
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'موظفون بملاحظات جودة' = CALCULATE([إجمالي الموظفين], Workforce[عدد_مشكلات_الجودة] > 0)
		formatString: #,##0

	/// مؤشر تنفيذي محسوب من بيانات القوى العاملة المنظفة
	measure 'إجمالي ملاحظات الجودة' = SUM(Workforce[عدد_مشكلات_الجودة])
		formatString: #,##0

	column الرقم_الوظيفي
		dataType: int64
		summarizeBy: none
		sourceColumn: الرقم_الوظيفي

	column اسم_الموظف
		dataType: string
		sourceColumn: اسم_الموظف

	column الجنس
		dataType: string
		sourceColumn: الجنس

	column الجنسية
		dataType: string
		sourceColumn: الجنسية

	column تاريخ_الميلاد
		dataType: dateTime
		sourceColumn: تاريخ_الميلاد

	column العمر
		dataType: int64
		summarizeBy: none
		sourceColumn: العمر

	column تاريخ_التعيين
		dataType: dateTime
		sourceColumn: تاريخ_التعيين

	column سنوات_الخدمة
		dataType: double
		summarizeBy: none
		sourceColumn: سنوات_الخدمة

	column المنشأة
		dataType: string
		sourceColumn: المنشأة

	column نوع_المنشأة
		dataType: string
		sourceColumn: نوع_المنشأة

	column الإدارة_التنفيذية
		dataType: string
		sourceColumn: الإدارة_التنفيذية

	column الفئة_الوظيفية
		dataType: string
		sourceColumn: الفئة_الوظيفية

	column المسمى_الوظيفي
		dataType: string
		sourceColumn: المسمى_الوظيفي

	column التصنيف
		dataType: string
		sourceColumn: التصنيف

	column نوع_التعاقد
		dataType: string
		sourceColumn: نوع_التعاقد

	column الحالة_الوظيفية
		dataType: string
		sourceColumn: الحالة_الوظيفية

	column الراتب_الأساسي
		dataType: int64
		summarizeBy: none
		sourceColumn: الراتب_الأساسي

	column تقييم_الأداء_2025
		dataType: double
		summarizeBy: none
		sourceColumn: تقييم_الأداء_2025

	column المؤهل_العلمي
		dataType: string
		sourceColumn: المؤهل_العلمي

	column مسجل_في_التصنيف_المهني
		dataType: string
		sourceColumn: مسجل_في_التصنيف_المهني

	column تاريخ_انتهاء_التصنيف
		dataType: dateTime
		sourceColumn: تاريخ_انتهاء_التصنيف

	column حالة_التصنيف
		dataType: string
		sourceColumn: حالة_التصنيف

	column جهة_العمل_الفعلية
		dataType: string
		sourceColumn: جهة_العمل_الفعلية

	column تعارض_الدور
		dataType: string
		sourceColumn: تعارض_الدور

	column ملخص_مشكلات_الجودة
		dataType: string
		sourceColumn: ملخص_مشكلات_الجودة

	column عدد_مشكلات_الجودة
		dataType: int64
		summarizeBy: none
		sourceColumn: عدد_مشكلات_الجودة

