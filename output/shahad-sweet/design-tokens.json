  },
  "typography": {
    "font_family_ar": "'Tajawal', 'Noto Sans Arabic', sans-serif",
    "font_family_en": "'Inter', 'Poppins', sans-serif",
    "scale": {
      "hero_headline": "clamp(2.25rem, 5vw, 4rem)",
      "section_title": "clamp(1.75rem, 3.5vw, 2.75rem)",
      "card_title": "clamp(1.125rem, 2vw, 1.5rem)",
      "body": "1rem",
      "small": "0.875rem",
      "caption": "0.75rem"
    },
    "line_height": {
      "tight": 1.2,
      "normal": 1.6,
      "relaxed": 1.8
    },
    "font_weight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "spacing": {
    "section_y": "clamp(4rem, 8vw, 7rem)",
    "container_x": "clamp(1rem, 4vw, 2rem)",
    "card_padding": "clamp(1.25rem, 3vw, 2rem)",
    "grid_gap": "clamp(1rem, 2.5vw, 2rem)"
  },
  "borders": {
    "radius": {
      "sm": "0.5rem",
      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.5rem",
      "full": "9999px"
    },
    "width": {
      "thin": "1px",
      "medium": "2px"
    }
  },
  "shadows": {
    "card": "0 2px 12px rgba(62, 39, 35, 0.08)",
    "card_hover": "0 8px 30px rgba(62, 39, 35, 0.15)",
    "elevated": "0 12px 40px rgba(62, 39, 35, 0.12)",
    "glow": "0 0 30px rgba(212, 168, 71, 0.2)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms",
      "enter": "600ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "gentle": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    }
  }
}
