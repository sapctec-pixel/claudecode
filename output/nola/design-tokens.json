{
  "brand": "Nola",
  "archetype": "luxury",
  "style": "Classic Italian - Mediterranean Elegance",
  "colors": {
    "primary": {
      "olive": "#6B7B3A",
      "oliveMuted": "#8A9A5B",
      "oliveLight": "#A8B87C"
    },
    "secondary": {
      "tomato": "#C4362A",
      "tomatoMuted": "#D4564A",
      "tomatoLight": "#E8847B"
    },
    "neutral": {
      "cream": "#FFF8F0",
      "creamDark": "#F5EDE3",
      "warmWhite": "#FEFCF9",
      "parchment": "#F0E6D6",
      "charcoal": "#2C2C2C",
      "darkBrown": "#3D2B1F",
      "warmGray": "#6B6560",
      "lightGray": "#D4CFC8"
    },
    "accent": {
      "forestGreen": "#2D4A3E",
      "forestGreenLight": "#3D6454",
      "gold": "#B8935A",
      "goldLight": "#D4B07A",
      "burgundy": "#6B2D3E",
      "terracotta": "#C47A5A"
    },
    "dark": {
      "background": "#1A1614",
      "surface": "#252220",
      "surfaceElevated": "#302C28",
      "border": "#3D3834",
      "text": "#F0E6D6",
      "textMuted": "#A89E94"
    }
  },
  "typography": {
    "heading": {
      "fontFamily": "'Playfair Display', 'Noto Serif Arabic', Georgia, serif",
      "weights": [400, 600, 700],
      "letterSpacing": "-0.02em"
    },
    "body": {
      "fontFamily": "'Inter', 'Noto Sans Arabic', system-ui, sans-serif",
      "weights": [300, 400, 500, 600],
      "letterSpacing": "0"
    },
    "accent": {
      "fontFamily": "'Playfair Display', 'Noto Serif Arabic', Georgia, serif",
      "style": "italic",
      "usage": "Italian phrases, menu items, decorative text"
    },
    "scale": {
      "hero": "clamp(2.5rem, 6vw, 5rem)",
      "h1": "clamp(2rem, 4vw, 3.5rem)",
      "h2": "clamp(1.75rem, 3vw, 2.75rem)",
      "h3": "clamp(1.25rem, 2vw, 1.75rem)",
      "body": "1rem",
      "small": "0.875rem",
      "caption": "0.75rem"
    }
  },
  "spacing": {
    "sectionPadding": "clamp(4rem, 8vw, 8rem)",
    "containerMaxWidth": "1280px",
    "cardPadding": "2rem",
    "gap": {
      "small": "0.5rem",
      "medium": "1rem",
      "large": "2rem",
      "xlarge": "4rem"
    }
  },
  "borderRadius": {
    "small": "0.375rem",
    "medium": "0.75rem",
    "large": "1.5rem",
    "pill": "9999px"
  },
  "shadows": {
    "subtle": "0 2px 8px rgba(44, 44, 44, 0.06)",
    "card": "0 4px 24px rgba(44, 44, 44, 0.08)",
    "elevated": "0 8px 40px rgba(44, 44, 44, 0.12)",
    "warm": "0 4px 24px rgba(196, 54, 42, 0.08)"
  },
  "animation": {
    "duration": {
      "fast": "200ms",
      "normal": "400ms",
      "slow": "700ms",
      "reveal": "1000ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "entrance": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "elegant": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    }
  }
}