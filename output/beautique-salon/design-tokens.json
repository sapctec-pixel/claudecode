{
  "brand": "BEAUTIQUE SALON",
  "archetype": "clean_service",
  "visual_direction": "modern_chic_monochrome_accent",

  "colors": {
    "accent": {
      "primary": "#C4A07C",
      "primary_hover": "#B08D68",
      "primary_light": "#E8D5C0",
      "primary_muted": "rgba(196, 160, 124, 0.15)"
    },
    "neutral": {
      "white": "#FFFFFF",
      "off_white": "#FAFAF8",
      "light_grey": "#F0EFED",
      "grey": "#C8C6C2",
      "mid_grey": "#8A8885",
      "dark_grey": "#4A4845",
      "charcoal": "#2A2826",
      "near_black": "#1A1918",
      "black": "#0A0A09"
    },
    "semantic": {
      "success": "#6B8F71",
      "error": "#C45B5B",
      "info": "#7B8FA8"
    }
  },

  "themes": {
    "light": {
      "bg_primary": "#FFFFFF",
      "bg_secondary": "#FAFAF8",
      "bg_tertiary": "#F0EFED",
      "bg_inverse": "#1A1918",
      "text_primary": "#1A1918",
      "text_secondary": "#4A4845",
      "text_tertiary": "#8A8885",
      "text_inverse": "#FAFAF8",
      "border": "#E0DFDD",
      "border_strong": "#C8C6C2",
      "surface_card": "#FFFFFF",
      "surface_overlay": "rgba(26, 25, 24, 0.6)"
    },
    "dark": {
      "bg_primary": "#0A0A09",
      "bg_secondary": "#1A1918",
      "bg_tertiary": "#2A2826",
      "bg_inverse": "#FAFAF8",
      "text_primary": "#F0EFED",
      "text_secondary": "#C8C6C2",
      "text_tertiary": "#8A8885",
      "text_inverse": "#1A1918",
      "border": "#2A2826",
      "border_strong": "#4A4845",
      "surface_card": "#1A1918",
      "surface_overlay": "rgba(0, 0, 0, 0.7)"
    }
  },

  "typography": {
    "font_family_heading": "'Inter', 'Noto Sans Arabic', system-ui, sans-serif",
    "font_family_body": "'Inter', 'Noto Sans Arabic', system-ui, sans-serif",
    "font_family_mono": "'JetBrains Mono', 'Fira Code', monospace",
    "scale": {
      "display": { "size": "4.5rem", "weight": "200", "tracking": "0.04em", "leading": "1.05" },
      "h1": { "size": "3rem", "weight": "300", "tracking": "0.03em", "leading": "1.1" },
      "h2": { "size": "2.25rem", "weight": "300", "tracking": "0.02em", "leading": "1.15" },
      "h3": { "size": "1.5rem", "weight": "400", "tracking": "0.015em", "leading": "1.25" },
      "body_lg": { "size": "1.125rem", "weight": "300", "tracking": "0.01em", "leading": "1.7" },
      "body": { "size": "1rem", "weight": "300", "tracking": "0.01em", "leading": "1.7" },
      "caption": { "size": "0.8125rem", "weight": "400", "tracking": "0.06em", "leading": "1.5" },
      "overline": { "size": "0.75rem", "weight": "500", "tracking": "0.15em", "leading": "1.4" }
    }
  },

  "spacing": {
    "section_y": "8rem",
    "section_y_mobile": "4rem",
    "container_max": "1200px",
    "container_padding": "2rem",
    "container_padding_mobile": "1.25rem",
    "gap_sm": "0.5rem",
    "gap_md": "1rem",
    "gap_lg": "2rem",
    "gap_xl": "4rem"
  },

  "borders": {
    "radius_sm": "0.25rem",
    "radius_md": "0.5rem",
    "radius_lg": "1rem",
    "radius_full": "9999px",
    "width_thin": "1px",
    "width_medium": "2px"
  },

  "motion": {
    "duration_fast": "150ms",
    "duration_normal": "300ms",
    "duration_slow": "600ms",
    "duration_reveal": "900ms",
    "easing_default": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "easing_spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "easing_elegant": "cubic-bezier(0.16, 1, 0.3, 1)"
  },

  "shadows": {
    "sm": "0 1px 3px rgba(0, 0, 0, 0.06)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.08)",
    "lg": "0 12px 40px rgba(0, 0, 0, 0.12)",
    "accent_glow": "0 4px 20px rgba(196, 160, 124, 0.25)"
  }
}
