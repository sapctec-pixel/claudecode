{
  "brand": "Glamour Salon & Spa",
  "archetype": "clean-service",
  "colors": {
    "light": {
      "background": "#FFFFFF",
      "backgroundAlt": "#FAF8FC",
      "backgroundCard": "#FFFFFF",
      "surface": "#F5F0F7",
      "surfaceHover": "#EDE6F2",
